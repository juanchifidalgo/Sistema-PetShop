# Copiá este archivo como ".env" solo para probar en tu computadora. En Render, estas variables
# se cargan en "Environment". Nunca subas el archivo .env con datos reales a GitHub.

# Dirección de la base de datos de Supabase ("Session pooler", puerto 5432), con tu contraseña.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Texto largo al azar (40 caracteres o más). Firma las sesiones de los usuarios.
SESSION_SECRET=cambiame-por-un-texto-largo-al-azar-de-40-caracteres-o-mas

# Primer usuario (dueño). Solo se usan la primera vez que arranca el sistema con la base vacía.
ADMIN_EMAIL=dueno@mipetshop.com
ADMIN_PASSWORD=una-contraseña-segura

# "production" en Render (activa HTTPS obligatorio y cookies seguras).
NODE_ENV=development

# Opcional: nombre del negocio (aparece arriba a la izquierda y en los tickets).
SHOP_NAME=Mi Pet Shop

# Opcional: "false" si la base de datos es local, sin SSL.
# DATABASE_SSL=false

# Opcional: límite de la base para el aviso de espacio (MB). Supabase gratis = 500.
# DB_LIMIT_MB=500

# Opcional: informe semanal por email (Resend o Brevo, plan gratuito). Sin estas tres, el informe queda desactivado.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM=Mi Pet Shop <avisos@midominio.com>

# Opcional: clave para que un servicio externo (cron-job.org, gratis) dispare el informe semanal aunque
# Render esté dormido. Debe llamar con POST a https://TU-SISTEMA.onrender.com/api/cron/weekly-report
# y el encabezado X-Cron-Secret con este mismo valor.
# CRON_SECRET=otro-texto-largo-al-azar
